// ────────────── Output Configuration ──────────────
// Configuração dos Monitores (LG UltraGear 180Hz + Notebook)

// Monitor Principal: LG UltraGear (180Hz / HDMI-A-1)
output "HDMI-A-1" {
    mode "1920x1080@179.961"
    scale 1.0
    position x=0 y=0
}

// Monitor Secundário: Tela do Notebook (eDP-1)
output "eDP-1" {
    mode "1920x1200@60.000"
    scale 1.0
    position x=1920 y=0
}
animations {

  // Transição de workspaces
  workspace-switch {
      spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
  }

  // Movimento horizontal da fita de janelas
  horizontal-view-movement {
      spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
  }

  // Movimento suave das janelas
  window-movement {
      spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
  }

  // Redimensionamento de janelas
  window-resize {
      spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
  }

  // Notificações de configuração
  config-notification-open-close {
      spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
  }

  // Interface de captura de tela
  screenshot-ui-open {
      duration-ms 200
      curve "ease-out-quad"
  }

  // Visão geral (Overview)
  overview-open-close {
      spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
  }

  // Animação suave de abertura de janela (Clean & Smooth)
  window-open {
      duration-ms 200
      curve "ease-out-quad"
  }

  // Animação suave de fechamento de janela (Clean & Smooth)
  window-close {
      duration-ms 180
      curve "ease-out-cubic"
  }

}
